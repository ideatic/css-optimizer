{
    "name": "ideatic/css-optimizer",
    "description": "Optimize, minify and add vendor prefixes for your CSS",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Javier Marín",
            "email": "contacto@ideatic.net",
            "homepage": "http://www.ideatic.net/"
        }
    ],
    "require": {
        "php": ">=8.5"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "keywords": [
        "css"
    ],
    "bin": [
        "cli/css_optimizer.php"
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "phpstan/phpstan": "^2.3"
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress"
    }
}
